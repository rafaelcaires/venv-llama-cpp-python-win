# ── Model ────────────────────────────────────────────────────────────────────
# Filename of the GGUF model inside MODEL_DIR
MODEL_FILENAME=Qwen3-4B-Q4_K_M.gguf

# Directory where the model is stored (relative to project root or absolute)
MODEL_DIR=model

# ID reported by the /v1/models endpoint (used by clients like Continue.dev)
MODEL_ID=qwen3-4b

# Hugging Face repo to download the model from
# Other options (change REPO_ID + MODEL_FILENAME together):
#   REPO_ID=Qwen/Qwen3-1.7B-GGUF      MODEL_FILENAME=Qwen3-1.7B-Q4_K_M.gguf    (~25-35 tok/s)
#   REPO_ID=Qwen/Qwen3-4B-GGUF        MODEL_FILENAME=Qwen3-4B-Q4_K_M.gguf      (~12-18 tok/s)  ← padrão
#   REPO_ID=Qwen/Qwen3-8B-GGUF        MODEL_FILENAME=Qwen3-8B-Q4_K_M.gguf      (~5-8 tok/s)
REPO_ID=Qwen/Qwen3-4B-GGUF

# ── Inference ─────────────────────────────────────────────────────────────────
# Context window in tokens (higher = more RAM)
N_CTX=4096

# CPU threads — set to the number of physical cores on your machine
N_THREADS=8

# GPU layers offloaded to VRAM (0 = CPU only)
N_GPU_LAYERS=0

# Tokens processed in parallel during prompt evaluation (higher = faster TTFT, more RAM)
# 512 is a good default; try 1024 if you have spare RAM
N_BATCH=512

# Default sampling temperature (0.0 = deterministic, 1.0 = creative)
# Lower values are faster and more consistent for code
TEMPERATURE=0.1

# Default max tokens per response (lower = faster; 512 covers most code responses)
MAX_TOKENS=512

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# Optional API key — leave empty to disable auth (fine for local use)
API_KEY=

# Download model automatically on first startup if not present
AUTO_DOWNLOAD=true
