# ── Model ────────────────────────────────────────────────────────────────────
# Filename of the GGUF model inside MODEL_DIR
MODEL_FILENAME=Qwen3-1.7B-Q4_K_M.gguf

# Directory where the model is stored (relative to project root or absolute)
MODEL_DIR=model

# ID reported by the /v1/models endpoint (used by clients like Continue.dev)
MODEL_ID=qwen3-1.7b

# Hugging Face repo to download the model from
# Choose by CPU performance (change REPO_ID + MODEL_FILENAME + MODEL_ID together):
#   Budget CPU (Intel N-series, Celeron, Pentium):
#     REPO_ID=Qwen/Qwen3-1.7B-GGUF    MODEL_FILENAME=Qwen3-1.7B-Q4_K_M.gguf  ← padrão
#   Mid-range CPU (Core i5/i7, Ryzen 5):
#     REPO_ID=Qwen/Qwen3-4B-GGUF      MODEL_FILENAME=Qwen3-4B-Q4_K_M.gguf
#   High-end CPU (Core i7/i9, Ryzen 7/9, GPU dedicada):
#     REPO_ID=Qwen/Qwen3-8B-GGUF      MODEL_FILENAME=Qwen3-8B-Q4_K_M.gguf
REPO_ID=Qwen/Qwen3-1.7B-GGUF

# ── Inference ─────────────────────────────────────────────────────────────────
# Context window in tokens (higher = more RAM and slower inference)
# 2048 is enough for most autocomplete scenarios on budget hardware
N_CTX=2048

# CPU threads — set to the number of physical cores (NOT logical/HT) on your machine
N_THREADS=4

# GPU layers offloaded to GPU (0 = CPU only)
# Build Vulkan + Intel Iris Xe / AMD Radeon integrada: comece com 20, aumente se estável
# GPU dedicada (CUDA/ROCm): use 99 para offload total
N_GPU_LAYERS=0

# Tokens processed in parallel during prompt evaluation (higher = faster TTFT, more RAM)
# 256 is safe for budget hardware; try 512 if you have spare RAM
N_BATCH=256

# Default sampling temperature (0.0 = deterministic, 1.0 = creative)
TEMPERATURE=0.1

# Default max tokens per response (lower = faster; 256 covers most code responses)
MAX_TOKENS=256

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# Optional API key — leave empty to disable auth (fine for local use)
API_KEY=

# Download model automatically on first startup if not present
AUTO_DOWNLOAD=true
