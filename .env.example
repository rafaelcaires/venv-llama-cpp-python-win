# ── Model ────────────────────────────────────────────────────────────────────
# Filename of the GGUF model inside MODEL_DIR
MODEL_FILENAME=qwen2.5-coder-3b-instruct-q4_k_m.gguf

# Directory where the model is stored (relative to project root or absolute)
MODEL_DIR=model

# ID reported by the /v1/models endpoint (used by clients like Continue.dev)
MODEL_ID=qwen2.5-coder-3b-instruct

# Hugging Face repo to download the model from
# Other options (change REPO_ID + MODEL_FILENAME together):
#   REPO_ID=Qwen/Qwen2.5-Coder-1.5B-Instruct-GGUF  MODEL_FILENAME=qwen2.5-coder-1.5b-instruct-q4_k_m.gguf  (~25-35 tok/s)
#   REPO_ID=Qwen/Qwen2.5-Coder-3B-Instruct-GGUF    MODEL_FILENAME=qwen2.5-coder-3b-instruct-q4_k_m.gguf    (~12-18 tok/s)
#   REPO_ID=Qwen/Qwen2.5-Coder-7B-Instruct-GGUF    MODEL_FILENAME=qwen2.5-coder-7b-instruct-q4_k_m.gguf    (~5-8 tok/s)
REPO_ID=Qwen/Qwen2.5-Coder-3B-Instruct-GGUF

# ── Inference ─────────────────────────────────────────────────────────────────
# Context window in tokens (higher = more RAM)
N_CTX=4096

# CPU threads — set to the number of physical cores on your machine
N_THREADS=8

# GPU layers offloaded to VRAM (0 = CPU only)
N_GPU_LAYERS=0

# Default sampling temperature (0.0 = deterministic, 1.0 = creative)
TEMPERATURE=0.7

# Default max tokens per response
MAX_TOKENS=512

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# Optional API key — leave empty to disable auth (fine for local use)
API_KEY=

# Download model automatically on first startup if not present
AUTO_DOWNLOAD=true
